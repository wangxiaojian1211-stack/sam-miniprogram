page { background: #F4F7FB; }

.hero {
  background: linear-gradient(135deg, #0B3A75, #1558A6);
  padding: 34rpx 28rpx 76rpx;
}
.hero-title { color: #fff; font-size: 38rpx; font-weight: 800; display: block; }
.hero-desc { color: rgba(255,255,255,0.78); font-size: 24rpx; line-height: 1.55; display: block; margin-top: 10rpx; }

.form-card {
  margin: -42rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(31,42,61,0.07);
  position: relative;
}
.form-item { margin-bottom: 26rpx; }
.form-item:last-child { margin-bottom: 0; }
.label { color: #1F2A3D; font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
input,
textarea {
  width: 100%;
  background: #F7FAFD;
  border-radius: 16rpx;
  color: #1F2A3D;
  font-size: 28rpx;
  box-sizing: border-box;
}
input { height: 76rpx; padding: 0 18rpx; }
textarea { min-height: 160rpx; padding: 18rpx; line-height: 1.55; }

.save-btn {
  margin: 0 28rpx;
  height: 88rpx;
  line-height: 1;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #E31837, #F04B5F);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(227,24,55,0.22);
}
.save-btn::after { border: none; }
