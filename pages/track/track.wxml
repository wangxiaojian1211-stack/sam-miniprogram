<!-- 订单跟踪 -->
<view class="page">
  <!-- 状态大卡 -->
  <view class="status-hero">
    <text class="status-icon">{{statusIcon}}</text>
    <text class="status-text">{{order.statusText}}</text>
    <text class="order-id">订单号：{{order.id}}</text>
  </view>

  <!-- 进度条 -->
  <view class="progress-card">
    <view class="steps">
      <view
        class="step {{step.done ? 'step-done' : ''}} {{step.active ? 'step-active' : ''}}"
        wx:for="{{steps}}" wx:key="label"
      >
        <view class="step-dot">
          <text wx:if="{{step.done}}">✓</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <text class="step-label">{{step.label}}</text>
        <view class="step-line" wx:if="{{index < steps.length - 1}}"/>
      </view>
    </view>
  </view>

  <!-- 时间线 -->
  <view class="card">
    <text class="card-title">物流动态</text>
    <view class="timeline-item" wx:for="{{timelines}}" wx:key="time">
      <view class="tl-dot {{index === 0 ? 'tl-dot-active' : ''}}"/>
      <view class="tl-line" wx:if="{{index < timelines.length - 1}}"/>
      <view class="tl-content">
        <text class="tl-time">{{item.time}}</text>
        <text class="tl-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 商品 -->
  <view class="card">
    <text class="card-title">订单商品</text>
    <view class="order-item" wx:for="{{order.items}}" wx:key="name">
      <text class="oi-name">{{item.name}}</text>
      <text class="oi-count">× {{item.count}}</text>
      <text class="oi-price">¥{{item.price}}</text>
    </view>
    <view class="divider"/>
    <view class="total-row">
      <text>实付金额</text>
      <text class="price-lg">¥{{order.total}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-row">
    <button class="btn-contact" bindtap="contact">联系客服</button>
    <button class="btn-confirm" wx:if="{{order.status === 'delivering'}}" bindtap="confirm">确认收货</button>
  </view>

  <view class="safe-bottom"/>
</view>
