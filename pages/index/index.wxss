page { background: #F4F7FB; }

.custom-nav {
  background: #0B3A75;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
}
.custom-nav-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #0B3A75;
  padding: 20rpx 28rpx 34rpx;
  gap: 16rpx;
}
.search-inner {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(11,58,117,0.04);
}
.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #A6AFBA;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
  opacity: 0.7;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 4rpx;
  background: #A6AFBA;
  border-radius: 4rpx;
  right: -9rpx;
  bottom: -5rpx;
  transform: rotate(45deg);
}
.search-placeholder { color: #8A96A8; font-size: 28rpx; }
.notice-btn {
  color: #fff;
  font-size: 26rpx;
  border: 1rpx solid rgba(255,255,255,0.38);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.12);
}

.hero-card {
  position: relative;
  margin: 18rpx 28rpx 24rpx;
  height: 300rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #0B3A75;
  box-shadow: 0 18rpx 42rpx rgba(11,58,117,0.24);
}
.hero-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(6,32,66,0.88), rgba(6,32,66,0.34), rgba(6,32,66,0.08));
  z-index: 1;
}
.hero-copy {
  position: absolute;
  left: 30rpx;
  top: 38rpx;
  right: 220rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
.hero-kicker { color: #BFD6F2; font-size: 22rpx; letter-spacing: 0; }
.hero-title { color: #fff; font-size: 42rpx; font-weight: 800; margin: 14rpx 0 10rpx; line-height: 1.22; }
.hero-desc { color: rgba(255,255,255,0.84); font-size: 24rpx; line-height: 1.5; }
.banner { width: 100%; height: 300rpx; }
.banner-img { width: 100%; height: 300rpx; }

.cat-scroll { width: 100%; }
.cat-list {
  display: flex;
  padding: 4rpx 28rpx 22rpx;
  white-space: nowrap;
}
.cat-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 26rpx;
  margin-right: 12rpx;
  font-size: 28rpx;
  color: #536072;
  position: relative;
  flex-shrink: 0;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(31,42,61,0.06);
}
.cat-item-active {
  color: #fff;
  font-weight: 600;
  background: #0B3A75;
  box-shadow: 0 10rpx 24rpx rgba(11,58,117,0.2);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 18rpx;
  color: #1F2A3D;
}
.section-main { display: block; font-size: 34rpx; font-weight: 800; }
.title-sub { font-size: 24rpx; color: #7A8799; font-weight: normal; margin-top: 4rpx; display: block; }
.section-more { color: #0B3A75; background: #E6F0FB; font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 999rpx; }

.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  padding: 0 28rpx;
}
.goods-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(31,42,61,0.08);
}
.goods-img-wrap { position: relative; }
.goods-img { width: 100%; height: 246rpx; display: block; background: #EEF3F8; }
.hot-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #F04B5F, #E31837);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(227,24,55,0.28);
}
.goods-info { padding: 20rpx 18rpx 22rpx; }
.goods-name { font-size: 28rpx; font-weight: 700; color: #1F2A3D; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; min-height: 78rpx; }
.goods-spec { font-size: 24rpx; color: #7A8799; margin: 10rpx 0 12rpx; display: block; }
.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.goods-price { color: #E31837; font-weight: bold; font-size: 32rpx; }
.goods-fee { color: #8A96A8; font-size: 22rpx; margin-left: 4rpx; display: block; margin-top: 2rpx; }
.add-btn {
  width: 54rpx;
  height: 54rpx;
  background: #0B3A75;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(11,58,117,0.24);
}
